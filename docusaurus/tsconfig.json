{
  // This file is not used in compilation. It is here just for a nice editor experience.
  "extends": "@docusaurus/tsconfig/tsconfig.json",
  "compilerOptions": {
    "strict": true,
    "baseUrl": ".",
    "paths": {
      "@data": ["src/data"],
      "@data/*": ["src/data/*"],
      "@site/*": ["*"]
    },
    "lib": [
      "DOM",
      "ES2021.Intl", // for @js-temporal
    ],
  },
  "include": ["src", "plugins", "docusaurus.config.js", "sidebars.js", "scss.d.ts"],
  "exclude": ["build", ".docusaurus", "node_modules"]
}
